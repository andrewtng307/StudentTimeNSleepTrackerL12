<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <title>Time Management Tracker</title>
    
</head>
<body>
    <%- include ('partials/navbar.ejs') %>
    <div class="container mt-3">
        <h2>Time Management Tracker</h2>
        <p>Welcome to the Time Management Tracker! This application allows you to track your study time and manage your schedule.</p>
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Task Name</th>
                    <th>Deadline</th>
                    <th>Module</th>
                    <th>Edit</th>
                    <th>Delete</th>
                </tr>
            </thead>
            <tbody>
                <!-- Display the task information by looping through the tasks array-->
                <% for (let i = 0; i < tasks.length; i++) { %>
                    <tr>
                        <td><%= tasks[i].id %></td>
                        <td><a href="/task/<%= tasks[i].id %>"><%= tasks[i].taskName %></a></td>
                        <td><%= tasks[i].deadline %></td>
                        <td><%= tasks[i].module %></td>
                        <td><a href="/task/<%= tasks[i].id %>/update">Edit</a></td>
                        <td><a href="/task/<%= tasks[i].id %>/delete">Delete</a></td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </div>
</body>
</html>