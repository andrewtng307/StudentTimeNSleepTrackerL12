<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <title>Student Time & Sleep Tracker</title>
</head>
<body>
    <%- include('partials/navbar.ejs') %>

    <div class="container mt-4">
        <h2>Today's Overview</h2>

        <div class="row mt-3">
            <div class="col-md-4 mb-3">
                <div class="card text-center shadow-sm h-100">
                    <div class="card-body">
                        <h1>📋</h1>
                        <h4>Activities</h4>
                        <h2><%= tasks.length %></h2>
                        <p>tasks today</p>
                    </div>
                </div>
            </div>

            <div class="col-md-4 mb-3">
                <div class="card text-center shadow-sm h-100">
                    <div class="card-body">
                        <h1>📅</h1>
                        <h4>Deadlines</h4>
                        <h2><%= tasks.filter(task => task.condition !== 'Completed').length %></h2>
                        <p>upcoming</p>
                    </div>
                </div>
            </div>

            <div class="col-md-4 mb-3">
                <div class="card text-center shadow-sm h-100">
                    <div class="card-body">
                        <h1>🌙</h1>
                        <h4>Sleep</h4>
                        <h2><%= tasks.length > 0 ? tasks[0].sleepHours : 0 %> hrs</h2>
                        <p>last night</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="card mt-4 shadow-sm">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h4 class="mb-0">Upcoming Tasks</h4>
                <a href="/task/add" class="btn btn-primary btn-sm">Add Task</a>
            </div>

            <div class="card-body p-0">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Task</th>
                            <th>Deadline</th>
                            <th>Module</th>
                            <th>Priority</th>
                            <th>Condition</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% tasks.forEach(function(task) { %>
                            <tr>
                                <td><a href="/task/<%= task.id %>"><%= task.taskName %></a></td>
                                <td><%= task.deadline %></td>
                                <td><%= task.module %></td>
                                <td><span class="badge bg-secondary"><%= task.priority %></span></td>
                                <td><%= task.condition %></td>
                                <td>
                                    <a href="/task/<%= task.id %>/update" class="btn btn-warning btn-sm">Edit</a>
                                    <a href="/task/<%= task.id %>/delete" class="btn btn-danger btn-sm">Delete</a>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>

            <div class="card-footer text-center">
                <a href="/summary" class="btn btn-outline-dark">View All Activities</a>
            </div>
        </div>
    </div>
</body>
</html>
