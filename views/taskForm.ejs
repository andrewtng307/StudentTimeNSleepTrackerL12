<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= task ? 'Update Task' : 'Add Task' %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</head>
<body>
    <%- include('partials/navbar.ejs') %>

    <div class="container mt-4">
        <h2><%= task ? 'Update Task' : 'Add Task' %></h2>

        <form action="<%= task ? '/task/' + task.id + '/update' : '/task/add' %>" method="POST">
            <div class="mb-3">
                <label class="form-label">Task Name</label>
                <input type="text" class="form-control" name="taskName" value="<%= task ? task.taskName : '' %>" required>
            </div>

            <div class="mb-3">
                <label class="form-label">Deadline</label>
                <input type="date" class="form-control" name="deadline" value="<%= task ? task.deadline : '' %>" required>
            </div>

            <div class="mb-3">
                <label class="form-label">Module</label>
                <input type="text" class="form-control" name="module" value="<%= task ? task.module : '' %>" required>
            </div>

            <div class="mb-3">
                <label class="form-label">Priority</label>
                <select class="form-control" name="priority" required>
                    <option value="High" <%= task && task.priority === 'High' ? 'selected' : '' %>>High</option>
                    <option value="Medium" <%= task && task.priority === 'Medium' ? 'selected' : '' %>>Medium</option>
                    <option value="Low" <%= task && task.priority === 'Low' ? 'selected' : '' %>>Low</option>
                </select>
            </div>

            <div class="mb-3">
                <label class="form-label">Condition</label>
                <select class="form-control" name="condition" required>
                    <option value="Pending" <%= task && task.condition === 'Pending' ? 'selected' : '' %>>Pending</option>
                    <option value="In Progress" <%= task && task.condition === 'In Progress' ? 'selected' : '' %>>In Progress</option>
                    <option value="Completed" <%= task && task.condition === 'Completed' ? 'selected' : '' %>>Completed</option>
                </select>
            </div>

            <div class="mb-3">
                <label class="form-label">Sleep Hours</label>
                <input type="number" step="0.1" class="form-control" name="sleepHours" value="<%= task ? task.sleepHours : 6.5 %>" required>
            </div>

            <button type="submit" class="btn btn-primary"><%= task ? 'Update Task' : 'Add Task' %></button>
            <a href="/" class="btn btn-secondary">Cancel</a>
        </form>
    </div>
</body>
</html>
